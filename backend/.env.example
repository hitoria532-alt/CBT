# ---- Backend environment (copy to .env or set in Render/Railway dashboard) ----

# MongoDB connection. Local: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb://localhost:27017"

# Database name (Atlas creates it automatically)
DB_NAME="cbt_ujian"

# Allowed frontend origins, comma separated. Use your Vercel URL in production,
# e.g. https://cbt-sekolah.vercel.app,https://cbt.sekolahku.sch.id
CORS_ORIGINS="*"

# Long random string used to sign login tokens. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET="ganti-dengan-string-acak-panjang"

# First admin account, seeded automatically on every startup
ADMIN_EMAIL="admin@sekolah.id"
ADMIN_PASSWORD="ganti-password-ini"

# File storage: auto | emergent | mongo
# Self-hosted (Render/Railway/VPS) -> use "mongo" (images stored in MongoDB).
STORAGE_MODE="mongo"

# Only needed when STORAGE_MODE=emergent (Emergent object storage)
# EMERGENT_LLM_KEY=""

# Auto-submit expired exams from inside the app every N minutes (0 = off).
# Recommended on self-hosted deployments: 5
INTERNAL_CRON_MINUTES="5"

# Optional: shared secret for the external cron endpoint /api/cron/auto-submit
# WEBHOOK_CRON_SECRET=""
